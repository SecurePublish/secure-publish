# Copy to .env or export in your shell (never commit real tokens)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SECURE_PUBLISH_KV_NAMESPACE_ID=

# Default / interim tenant host (wildcard LIVE: *.securepublish.work → Worker)
# Prefer tenant slug when known: https://{slug}.securepublish.work
SECURE_PUBLISH_BASE_URL=https://demo.securepublish.work
# Fallback (same Worker, still up):
# SECURE_PUBLISH_BASE_URL=https://secure-publish.clovist.workers.dev
# Panel URLs:
#   wildcard → https://{slug}.securepublish.work/{panel-id}  (demo interim)
#   fallback → https://secure-publish.clovist.workers.dev/{panel-id}

# Mock / local E2E (no Cloudflare token required)
# SECURE_PUBLISH_MOCK=1
# SECURE_PUBLISH_COMPANY_DOMAINS=empresa.com

# ─── Cloudflare Access (preferred SSO) — set on the Worker ───
# TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
# POLICY_AUD=

# ─── Alternative: Worker OAuth secrets (wrangler secret put …) ───
# SESSION_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Edge default company-wide ACL = email domain allowlist (NOT Workspace/Entra/GitHub Org membership)
# OAUTH_ALLOWED_DOMAINS=empresa.com

# Console (Pages) origin(s) for Worker CORS — set as Worker var CONSOLE_ORIGIN
# CONSOLE_ORIGIN=https://app.securepublish.work,https://secure-publish-app.pages.dev,http://127.0.0.1:8765
# SECURE_PUBLISH_PUBLISHER_EMAIL=you@empresa.com
# Console SP_API_BASE: https://secure-publish.clovist.workers.dev  OR  any *.securepublish.work
# (same Worker serves /api/* on both hosts). SameSite=None while Pages↔workers.dev; see docs/security-cookie-cross-origin.md
