{
  "name": "secure-publish-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CLI and agent skill to publish HTML pages that only your company or listed people can open",
  "bin": {
    "securepublish-cli": "./packages/cli/bin/securepublish-cli.cjs"
  },
  "scripts": {
    "securepublish-cli": "node packages/cli/bin/securepublish-cli.cjs",
    "doctor": "node packages/cli/bin/securepublish-cli.cjs doctor",
    "list": "node packages/cli/bin/securepublish-cli.cjs list",
    "e2e:mock": "node scripts/e2e-mock.mjs",
    "test": "node --test packages/cli/test/*.test.js",
    "test:cli-bin": "node --test test/github-npx-bin.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SecurePublish/secure-publish.git"
  },
  "homepage": "https://github.com/SecurePublish/secure-publish",
  "bugs": {
    "url": "https://github.com/SecurePublish/secure-publish/issues"
  },
  "engines": {
    "node": ">=20"
